{
  "name": "@oratge/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Oratge design system — warm, pastel weather UI components (design source for Claude Design; the app itself is Flutter).",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
